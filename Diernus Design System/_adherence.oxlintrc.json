{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/forms/**",
              "components/media/**",
              "components/sheet/**",
              "ui_kits/site/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Figtree|Caveat|IBM Plex Mono))/i]",
        "message": "Font not provided by the design system. Available: Figtree, Caveat, IBM Plex Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|href|as|disabled|children|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, href, as, disabled, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|ghost|bar)$/]",
        "message": "<Button> variant must be one of 'primary' | 'ghost' | 'bar'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<Button> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checklist'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|tone|style|key|ref|className|style|children)$/]",
        "message": "<Checklist> doesn't accept that prop. Declared props: items, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checklist'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:blueprint|bone)$/]",
        "message": "<Checklist> tone must be one of 'blueprint' | 'bone'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute > JSXIdentifier[name!=/^(?:href|tone|children|style|key|ref|className|style|children)$/]",
        "message": "<Chip> doesn't accept that prop. Declared props: href, tone, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:default|accent|stamp)$/]",
        "message": "<Chip> tone must be one of 'default' | 'accent' | 'stamp'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|children|style|key|ref|className|style|children)$/]",
        "message": "<Eyebrow> doesn't accept that prop. Declared props: tone, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:accent|stamp|muted|ink)$/]",
        "message": "<Eyebrow> tone must be one of 'accent' | 'stamp' | 'muted' | 'ink'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Field'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|id|required|type|rows|error|placeholder|tone|style|key|ref|className|style|children)$/]",
        "message": "<Field> doesn't accept that prop. Declared props: label, id, required, type, rows, error, placeholder, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Field'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:blueprint|bone)$/]",
        "message": "<Field> tone must be one of 'blueprint' | 'bone'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FormFeedback'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|action|onAction|children|style|key|ref|className|style|children)$/]",
        "message": "<FormFeedback> doesn't accept that prop. Declared props: tone, action, onAction, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FormFeedback'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:success|error)$/]",
        "message": "<FormFeedback> tone must be one of 'success' | 'error'."
      },
      {
        "selector": "JSXOpeningElement[name.name='HandNote'] > JSXAttribute > JSXIdentifier[name!=/^(?:rotate|size|children|style|key|ref|className|style|children)$/]",
        "message": "<HandNote> doesn't accept that prop. Declared props: rotate, size, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='LangToggle'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|options|onChange|tone|style|key|ref|className|style|children)$/]",
        "message": "<LangToggle> doesn't accept that prop. Declared props: value, options, onChange, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='LangToggle'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:graphite|ink)$/]",
        "message": "<LangToggle> tone must be one of 'graphite' | 'ink'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MaterialCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:code|name|texture|supplierRef|children|style|key|ref|className|style|children)$/]",
        "message": "<MaterialCard> doesn't accept that prop. Declared props: code, name, texture, supplierRef, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='MoodFigure'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|alt|caption|dot|rotate|height|style|key|ref|className|style|children)$/]",
        "message": "<MoodFigure> doesn't accept that prop. Declared props: src, alt, caption, dot, rotate, height, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='NoteCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:kicker|title|children|style|key|ref|className|style|children)$/]",
        "message": "<NoteCard> doesn't accept that prop. Declared props: kicker, title, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='RevisionItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:rev|date|status|latest|children|style|key|ref|className|style|children)$/]",
        "message": "<RevisionItem> doesn't accept that prop. Declared props: rev, date, status, latest, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHead'] > JSXAttribute > JSXIdentifier[name!=/^(?:kicker|title|lede|tone|style|key|ref|className|style|children)$/]",
        "message": "<SectionHead> doesn't accept that prop. Declared props: kicker, title, lede, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHead'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:bone|blueprint)$/]",
        "message": "<SectionHead> tone must be one of 'bone' | 'blueprint'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SketchCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|alt|title|index|tape|rotate|crop|style|key|ref|className|style|children)$/]",
        "message": "<SketchCard> doesn't accept that prop. Declared props: src, alt, title, index, tape, rotate, crop, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SpecCell'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|unit|label|style|key|ref|className|style|children)$/]",
        "message": "<SpecCell> doesn't accept that prop. Declared props: value, unit, label, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SpecGrid'] > JSXAttribute > JSXIdentifier[name!=/^(?:columns|children|style|key|ref|className|style|children)$/]",
        "message": "<SpecGrid> doesn't accept that prop. Declared props: columns, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Stamp'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|sub|rotate|style|key|ref|className|style|children)$/]",
        "message": "<Stamp> doesn't accept that prop. Declared props: label, sub, rotate, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusDot'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|children|style|key|ref|className|style|children)$/]",
        "message": "<StatusDot> doesn't accept that prop. Declared props: tone, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusDot'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:amber|cobalt)$/]",
        "message": "<StatusDot> tone must be one of 'amber' | 'cobalt'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SubmitButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:loading|children|style|key|ref|className|style|children)$/]",
        "message": "<SubmitButton> doesn't accept that prop. Declared props: loading, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TitleBlock'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|style|key|ref|className|style|children)$/]",
        "message": "<TitleBlock> doesn't accept that prop. Declared props: items, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TrustList'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|tone|style|key|ref|className|style|children)$/]",
        "message": "<TrustList> doesn't accept that prop. Declared props: items, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TrustList'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:blueprint|bone)$/]",
        "message": "<TrustList> tone must be one of 'blueprint' | 'bone'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wordmark'] > JSXAttribute > JSXIdentifier[name!=/^(?:href|size|tone|accent|style|key|ref|className|style|children)$/]",
        "message": "<Wordmark> doesn't accept that prop. Declared props: href, size, tone, accent, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wordmark'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:graphite|ink)$/]",
        "message": "<Wordmark> tone must be one of 'graphite' | 'ink'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
